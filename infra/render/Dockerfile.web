FROM php:8.3-cli-alpine AS php-deps

RUN apk add --no-cache git unzip icu-dev libzip-dev oniguruma-dev postgresql-dev \
    && docker-php-ext-install bcmath intl mbstring pdo_pgsql zip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

COPY . .

RUN composer dump-autoload --optimize --no-dev

FROM node:20-alpine AS frontend-build

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY resources ./resources
COPY public ./public
COPY vite.config.js postcss.config.js tailwind.config.js eslint.config.js jsconfig.json ./

RUN npm run build

FROM php:8.3-fpm-alpine AS app

RUN apk add --no-cache gettext icu-dev libzip-dev nginx oniguruma-dev postgresql-client supervisor \
    && docker-php-ext-install bcmath intl mbstring opcache pdo_pgsql zip \
    && mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

WORKDIR /var/www/html

COPY . .
COPY --from=php-deps /app/vendor ./vendor
COPY --from=frontend-build /app/public/build ./public/build
COPY infra/production/php/php.ini $PHP_INI_DIR/conf.d/99-app.ini
COPY infra/production/php/www.conf /usr/local/etc/php-fpm.d/zz-app.conf
COPY infra/render/nginx.default.conf.template /etc/nginx/http.d/default.conf.template
COPY infra/render/supervisord.web.conf /etc/supervisord.conf
COPY infra/render/web-entrypoint.sh /usr/local/bin/render-web-entrypoint

RUN chmod +x /usr/local/bin/render-web-entrypoint \
    && rm -rf node_modules \
    && mkdir -p \
        /run/nginx \
        /var/lib/nginx/tmp/client_body \
        /var/www/html/storage/app/public \
        /var/www/html/storage/app/private \
        /var/www/html/storage/framework/cache/data \
        /var/www/html/storage/framework/sessions \
        /var/www/html/storage/framework/views \
        /var/www/html/storage/logs \
        /var/www/html/bootstrap/cache \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache /run/nginx /var/lib/nginx /var/log/nginx

ENV PORT=10000

EXPOSE 10000

ENTRYPOINT ["/usr/local/bin/render-web-entrypoint"]
CMD ["supervisord", "-c", "/etc/supervisord.conf"]
