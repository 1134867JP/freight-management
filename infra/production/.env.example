COMPOSE_PROJECT_NAME=freight-management

# Ative apenas se for usar WhatsApp. Quando vazio, os containers da Evolution não sobem.
# Para subir SEM Evolution: deixe COMPOSE_PROFILES= vazio (ou não defina)
# Para subir COM Evolution: defina COMPOSE_PROFILES=evolution
COMPOSE_PROFILES=

APP_IMAGE=freight-management-app:latest
WEB_IMAGE=freight-management-web:latest
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:latest

APP_DOMAIN=localhost
EVOLUTION_DOMAIN=localhost
APP_PUBLIC_URL=https://localhost:8443
EVOLUTION_PUBLIC_URL=https://localhost:8444
APP_PORT_HTTP=8080
APP_PORT_HTTPS=8443
EVOLUTION_PORT_HTTP=8088
EVOLUTION_PORT_HTTPS=8444
APP_TLS_CERT=app.fullchain.pem
APP_TLS_KEY=app.privkey.pem
EVOLUTION_TLS_CERT=evolution.fullchain.pem
EVOLUTION_TLS_KEY=evolution.privkey.pem
NGINX_AUTO_SELF_SIGNED=true
NGINX_CLIENT_MAX_BODY_SIZE=20m
TRUSTED_PROXIES=*

APP_NAME=Freight Management
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:generate-this-on-the-server
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_DATABASE=freight_management
DB_USERNAME=freight_management
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=app-redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Freight Management

EVOLUTION_ENABLED=true
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=freight-management
EVOLUTION_TIMEOUT=10

EVOLUTION_DB_DATABASE=evolution
EVOLUTION_DB_USERNAME=evolution
EVOLUTION_DB_PASSWORD=change-me
SERVER_NAME=evolution
SERVER_TYPE=https
SERVER_PORT=8080
SERVER_URL=https://localhost:8444
SERVER_DISABLE_DOCS=true
SERVER_DISABLE_MANAGER=true
CORS_ORIGIN=https://localhost:8443
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:change-me@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=false
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution-cache
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_LOCAL_ENABLED=true
CACHE_LOCAL_TTL=86400
AUTHENTICATION_API_KEY=change-me
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
LOG_COLOR=true
LOG_BAILEYS=error
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=true
LANGUAGE=pt-BR
WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=true
CONFIG_SESSION_PHONE_CLIENT=Freight Management
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR=#198754
